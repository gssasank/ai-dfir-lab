; /etc/dfir-lab/lab.conf - settings for the dfir-lab toolkit.
;
; INI format. Lines starting with ; or # are comments; "; text" after a value
; is a comment too. The environment variable DFIR_LAB_CONF overrides the path
; of this file (used by the tests). Values marked REQUIRED have no default;
; every other value shows its default.
;
; Nothing in the toolkit code is specific to one gateway or one case: change
; this file, not the code.

[lab]
version = 0.1.0                      ; image/lab version shown in every report and readiness code
course = CYBERSEC 510
support_contact =                    ; e.g. "the TA on the course Ed board"; shown in failure messages

[gateway]
base_url =                           ; REQUIRED. Root URL without /v1, e.g. https://litellm.example.edu
auth_style = bearer                  ; bearer | x-api-key | both  (used by dfir-lab's own checks;
                                     ; Claude Code's apiKeyHelper value is sent in both headers)
model_main =                         ; REQUIRED. Model ID Claude Code uses
model_small =                        ; model ID for background tasks (default: model_main)
connect_timeout_s = 8                ; seconds to wait for DNS / TCP / TLS
request_timeout_s = 60               ; seconds to wait for a reply once connected
network_hint = Connect to the Duke VPN on your host computer, then try again.
dashboard_url =                      ; where students copy their key; named in "key rejected" messages

[claude]
binary = claude                      ; Claude Code program (name on PATH or absolute path)
max_turns_readiness = 6              ; turn limit for readiness check 10
readiness_timeout_s = 180            ; wall-clock limit for readiness check 10
; Claude Code effort level: low, medium, high, xhigh, max or auto (empty = Claude
; Code's own default, medium for Haiku 5.5). Set as CLAUDE_CODE_EFFORT_LEVEL, which
; takes precedence over /effort, so every student runs at the same level.
effort =
; Optional extra environment for Claude Code, one NAME=VALUE per indented line.
; It is written into ~/.claude/settings.json "env" and set when dfir-lab starts
; Claude Code. Never put the key here, and do not set ANTHROPIC_API_KEY,
; ANTHROPIC_AUTH_TOKEN or a CLAUDE_CODE_USE_* provider selector: the toolkit
; neutralises those and refuses a lab.conf that sets them.
; Examples (from the Claude Code gateway docs):
;   CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS=1   if the gateway rejects unknown beta fields
;   API_TIMEOUT_MS=600000
extra_env =

[case]
id =                                 ; REQUIRED. Short case identifier, used in file names
title =                              ; human-readable case name (default: id)
dir =                                ; REQUIRED. Case folder, e.g. /cases/<id>. A relative path is
                                     ; resolved against the folder holding this file.
manifest = MANIFEST.sha256           ; relative to dir; sha256sum format: "<hash>  <file>"
checkpoints = checkpoints.json       ; relative to dir; built by dfir-lab-make-checkpoints
tools_file = tools.list              ; relative to dir; one "command<TAB>version-args" per line
replay_dir = fallback                ; relative to dir; *.jsonl recordings for dfir-lab replay
; Optional, off by default: students fill in the worksheet outside the VM.
; When both are set, `dfir-lab start` copies the template to the worksheet once
; and names the worksheet in its banner.
worksheet =                          ; relative to dir, e.g. worksheet.md
worksheet_template =                 ; relative to dir, e.g. worksheet.template.md
ticket = ticket.md                   ; relative to dir; incident ticket shown in the start banner
ai_report =                          ; relative to dir; AI-written report students audit, named
                                     ; in the start banner (e.g. ai-report.md)

[disk]
; The case's disk image, mounted read-only and noexec by `dfir-lab mount` (and by
; `dfir-lab start` when it is not mounted). Leave image empty when the case has none.
image =                              ; first E01 segment, e.g. /cases/<id>/disk/DC01.E01; the
                                     ; other segments (DC01.E02, ...) sit beside it
segments =                           ; files in the image's folder and their SHA-256, checked by
                                     ; readiness check 3: "name:sha256 name:sha256 ..."
mount_point = /mnt/dc01              ; where the Windows volume is mounted (no spaces)
ewf_mount =                          ; ewfmount folder (default: ewf_<name> beside mount_point)
probe = Windows/System32/config/SYSTEM  ; file read through the mount to prove it works
probe_magic = regf                   ; its first bytes
zip_name =                           ; download name shown in messages, e.g. DC01-E01.zip

[requirements]
min_ram_mb = 5500                    ; below this: WARN
min_free_disk_gb = 10                ; below this: FAIL
min_cpus = 2                         ; below this: WARN
