#!/usr/bin/env python3
"""dfir-lab-make-checkpoints - see lab/README.md. Finds the dfir_lab package next to this file
(repository: ../lib, installed: ../lib/dfir-lab) or in $DFIR_LAB_LIB."""
import os
import sys

_here = os.path.dirname(os.path.realpath(__file__))
for _cand in (os.environ.get("DFIR_LAB_LIB"),
              os.path.join(_here, "..", "lib", "dfir-lab"),
              os.path.join(_here, "..", "lib"),
              "/usr/local/lib/dfir-lab"):
    if _cand and os.path.isdir(os.path.join(_cand, "dfir_lab")):
        sys.path.insert(0, os.path.abspath(_cand))
        break

from dfir_lab.make_checkpoints import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
